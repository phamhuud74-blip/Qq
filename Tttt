-- 4. Logic Xử Lý Tin Nhắn & Nút Copy
local function AddMessage(sender, text, color, isAI)
    local MsgContainer = Instance.new("Frame")
    MsgContainer.Size = UDim2.new(1, 0, 0, 0)
    MsgContainer.BackgroundTransparency = 1
    MsgContainer.Parent = ChatScroll

    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = isAI and UDim2.new(1, -55, 0, 0) or UDim2.new(1, 0, 0, 0)
    MsgLabel.Position = UDim2.new(0, 0, 0, 0)
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Text = "<b>" .. sender .. ":</b> " .. text
    MsgLabel.TextColor3 = color
    MsgLabel.TextSize = 13
    MsgLabel.Font = Enum.Font.SourceSans
    MsgLabel.RichText = true
    MsgLabel.TextWrapped = true
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.Parent = MsgContainer

    -- Chỉnh kích thước khung chứa theo độ dài chữ
    local textHeight = MsgLabel.TextBounds.Y + 4
    MsgLabel.Size = isAI and UDim2.new(1, -55, 0, textHeight) or UDim2.new(1, 0, 0, textHeight)
    MsgContainer.Size = UDim2.new(1, 0, 0, textHeight)

    -- Thêm Nút Copy cho tin nhắn của AI
    if isAI then
        local CopyBtn = Instance.new("TextButton")
        CopyBtn.Size = UDim2.new(0, 48, 0, 22)
        CopyBtn.Position = UDim2.new(1, -50, 0, 0)
        CopyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        CopyBtn.Text = "Copy"
        CopyBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        CopyBtn.TextSize = 11
        CopyBtn.Font = Enum.Font.SourceSansBold
        CopyBtn.Parent = MsgContainer

        local CopyCorner = Instance.new("UICorner")
        CopyCorner.CornerRadius = UDim.new(0, 5)
        CopyCorner.Parent = CopyBtn

        CopyBtn.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(text)
                CopyBtn.Text = "Đã chép!"
                CopyBtn.BackgroundColor3 = Color3.fromRGB(46, 139, 87)
                task.wait(1.5)
                CopyBtn.Text = "Copy"
                CopyBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
            else
                CopyBtn.Text = "Lỗi"
            end
        end)
    end

    ChatScroll.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y + 10)
    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.CanvasSize.Y.Offset)
end

local function SendToAI(prompt)
    if prompt == "" then return end
    
    AddMessage("Bạn", prompt, Color3.fromRGB(120, 200, 255), false)
    InputBox.Text = ""
    
    local LoadingContainer = Instance.new("Frame")
    LoadingContainer.Size = UDim2.new(1, 0, 0, 20)
    LoadingContainer.BackgroundTransparency = 1
    LoadingContainer.Parent = ChatScroll

    local LoadingLabel = Instance.new("TextLabel")
    LoadingLabel.Size = UDim2.new(1, 0, 1, 0)
    LoadingLabel.BackgroundTransparency = 1
    LoadingLabel.Text = "<b>Duongvatvn AI:</b> Đang suy nghĩ..."
    LoadingLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    LoadingLabel.TextSize = 13
    LoadingLabel.Font = Enum.Font.SourceSans
    LoadingLabel.RichText = true
    LoadingLabel.TextXAlignment = Enum.TextXAlignment.Left
    LoadingLabel.Parent = LoadingContainer

    ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.CanvasSize.Y.Offset)

    task.spawn(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then
            local cleanPrompt = HttpService:UrlEncode(prompt)
            local url = "https://text.pollinations.ai/" .. cleanPrompt .. "?model=openai"

            local success, response = pcall(function()
                return req({
                    Url = url,
                    Method = "GET"
                })
            end)

            LoadingContainer:Destroy()

            if success and response.StatusCode == 200 and response.Body ~= "" then
                AddMessage("Duongvatvn AI", response.Body, Color3.fromRGB(150, 255, 150), true)
            else
                AddMessage("Duongvatvn AI", "Không kết nối được server AI. Hãy thử lại!", Color3.fromRGB(255, 100, 100), false)
            end
        else
            LoadingContainer:Destroy()
            AddMessage("Duongvatvn AI", "Executor Delta X chưa bật tính năng Request HTTP.", Color3.fromRGB(255, 100, 100), false)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function()
    SendToAI(InputBox.Text)
end)

InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SendToAI(InputBox.Text)
    end
end)

