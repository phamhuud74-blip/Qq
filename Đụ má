-- 4. FPS & PING REALTIME
local lastUpdate, frameCount = 0, 0
local renderConn = RunService.RenderStepped:Connect(function(step)
    frameCount = frameCount + 1
    lastUpdate = lastUpdate + step
    if lastUpdate >= 0.5 then
        local currentFps = math.floor(frameCount / lastUpdate)
        frameCount, lastUpdate = 0, 0
        local currentPing = 0
        pcall(function() currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        TitleText.Text = string.format("Duongvatvn | FPS: %d | Ping: %dms", currentFps, currentPing)
    end
end)

-- 5. LẮP RÁP CÁC KHỚP VÀ VÒNG LẶP NẮM CỔ
local function GetRightShoulder(char)
    if not char then return nil end
    if char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Right Shoulder") then
        return char.Torso["Right Shoulder"]
    elseif char:FindFirstChild("RightUpperArm") and char.RightUpperArm:FindFirstChild("RightShoulder") then
        return char.RightUpperArm.RightShoulder
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not isMonsterMode then return end
    
    if isGrabbing then
        local shoulder = GetRightShoulder(char)
        if shoulder then
            if not savedShoulderC0 then savedShoulderC0 = shoulder.C0 end
            shoulder.C0 = CFrame.new(shoulder.C0.Position) * CFrame.Angles(math.rad(90), 0, math.rad(15))
        end
        
        if grabbedTarget and grabbedTarget.Character and grabbedTarget.Character:FindFirstChild("HumanoidRootPart") then
            local myHrp = char:FindFirstChild("HumanoidRootPart")
            local targetHrp = grabbedTarget.Character.HumanoidRootPart
            if myHrp and targetHrp then
                targetHrp.CFrame = myHrp.CFrame * CFrame.new(0.6, 1.2, -2.2) * CFrame.Angles(0, math.rad(180), 0)
                targetHrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    else
        local shoulder = GetRightShoulder(char)
        if shoulder and savedShoulderC0 then
            shoulder.C0 = savedShoulderC0
            savedShoulderC0 = nil
        end
    end
end)

-- 6. TÌM NGƯỜI CHƠI TRƯỚC MẶT
local function GetNearestPlayerInFront()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myHrp = myChar.HumanoidRootPart
    
    local closestPlr = nil
    local minDistance = 18
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = plr.Character.HumanoidRootPart
            local dist = (targetHrp.Position - myHrp.Position).Magnitude
            if dist < minDistance then
                local dir = (targetHrp.Position - myHrp.Position).Unit
                if myHrp.CFrame.LookVector:Dot(dir) > 0.1 then
                    minDistance = dist
                    closestPlr = plr
                end
            end
        end
    end
    return closestPlr
end

-- 7. CHỨC NĂNG 1: SERVER PHẲNG
local function ToggleFlatServer(enable)
    isFlatServer = enable
    if enable then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) and obj.Name ~= "Terrain" then
                if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder") then
                    table.insert(hiddenMapObjects, {instance = obj, parent = obj.Parent})
                    obj.Parent = nil
                end
            end
        end
        
        createdBaseplate = Instance.new("Part")
        createdBaseplate.Name = "DuongvatvnBaseplate"
        createdBaseplate.Size = Vector3.new(2000, 1, 2000)
        createdBaseplate.Position = Vector3.new(0, 0, 0)
        createdBaseplate.Anchored = true
        createdBaseplate.Material = Enum.Material.SmoothPlastic
        createdBaseplate.Color = Color3.fromRGB(50, 50, 60)
        createdBaseplate.Parent = Workspace
        
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = CFrame.new(0, 5, 0)
        end
    else
        if createdBaseplate then
            createdBaseplate:Destroy()
            createdBaseplate = nil
        end
        for _, item in ipairs(hiddenMapObjects) do
            if item.instance then
                item.instance.Parent = item.parent
            end
        end
        hiddenMapObjects = {}
    end
end

-- 8. CHỨC NĂNG 2: FLING NGƯỜI CHƠI
local function ToggleFling(enable)
    isFlingActive = enable
    if enable then
        flingConn = RunService.Heartbeat:Connect(function()
            if not isFlingActive then return end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local oldVel = hrp.Velocity
                hrp.Velocity = Vector3.new(10000, 10000, 10000)
                RunService.RenderStepped:Wait()
                hrp.Velocity = oldVel
            end
        end)
    else
        if flingConn then
            flingConn:Disconnect()
            flingConn = nil
        end
    end
end

-- 9. CHỨC NĂNG 3: QUÁI VẬT & MẮT ĐỎ
local function ToggleMonsterMode(enable)
    isMonsterMode = enable
    local char = LocalPlayer.Character
    if not char then return end
    
    if enable then
        local head = char:FindFirstChild("Head")
        if head then
            for _, offset in ipairs({Vector3.new(-0.25, 0.2, -0.55), Vector3.new(0.25, 0.2, -0.55)}) do
                local eye = Instance.new("Part")
                eye.Size = Vector3.new(0.2, 0.2, 0.2)
                eye.Color = Color3.fromRGB(255, 0, 0)
                eye.Material = Enum.Material.Neon
                eye.CanCollide = false
                
                local weld = Instance.new("Weld")
                weld.Part0 = head
                weld.Part1 = eye
                weld.C0 = CFrame.new(offset)
                weld.Parent = eye
                
                eye.Parent = char
                table.insert(eyeParts, eye)
            end
        end
        
        monsterConn = RunService.RenderStepped:Connect(function()
            if not isMonsterMode then return end
            local headPart = char:FindFirstChild("Head")
            local neck = headPart and (headPart:FindFirstChild("Neck") or (char:FindFirstChild("Torso") and char.Torso:FindFirstChild("Neck")) or (char:FindFirstChild("UpperTorso") and char.UpperTorso:FindFirstChild("Neck")))
            if neck then
                if not originalNeckC0 then originalNeckC0 = neck.C0 end
                if math.random(1, 4) == 1 then
                    neck.C0 = originalNeckC0 * CFrame.Angles(
                        math.rad(math.random(-15, 15)),
                        math.rad(math.random(-15, 15)),
                        math.rad(math.random(-15, 15))
                    )
                end
            end
        end)
    else
        if monsterConn then monsterConn:Disconnect() monsterConn = nil end
        for _, eye in ipairs(eyeParts) do if eye then eye:Destroy() end end
        eyeParts = {}
        isGrabbing = false
        grabbedTarget = nil
    end
end

-- 10. BẤM MÀN HÌNH NẮM CỔ & NÉM
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not isMonsterMode then return end
    
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local myHrp = myChar.HumanoidRootPart
        
        -- LẦN CHẠM 2: NÉM BAY XA
        if isGrabbing and grabbedTarget and grabbedTarget.Character then
            local targetHrp = grabbedTarget.Character:FindFirstChild("HumanoidRootPart")
            local targetPlrName = grabbedTarget.Name
            
            isGrabbing = false
            grabbedTarget = nil
            
            if targetHrp then
                local throwDir = myHrp.CFrame.LookVector * 120 + Vector3.new(0, 50, 0)
                task.spawn(function()
                    for i = 1, 12 do
                        if targetHrp then
                            targetHrp.CFrame = targetHrp.CFrame + (myHrp.CFrame.LookVector * 8) + Vector3.new(0, 3, 0)
                            targetHrp.Velocity = throwDir
                        end
                        task.wait(0.015)
                    end
                end)
            end
            
            StatusLabel.Text = "🔥 Đã NÉM " .. targetPlrName .. " bay xa!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            return
        end
        
        -- LẦN CHẠM 1: NẮM CỔ
        local targetPlr = GetNearestPlayerInFront()
        if targetPlr and targetPlr.Character then
            grabbedTarget = targetPlr
            isGrabbing = true
            
            StatusLabel.Text = "✊ ĐANG NẮM CỔ: " .. targetPlr.Name .. "\nNhấn màn hình lần nữa để NÉM!"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        end
    end
end)

